# Appended to ~/.config/airflow.env (the EnvironmentFile of the airflow-* units). Versioned without secrets.
# Task logs where Alloy can read them (no ACLs on the home directory): /var/log/lambda/airflow
AIRFLOW__LOGGING__BASE_LOG_FOLDER=/var/log/lambda/airflow
# Airflow metrics over OpenTelemetry (OTLP/HTTP) -> Alloy :4318 -> Prometheus (remote write), job="airflow".
# Airflow >= 3.2 deprecated [metrics] otel_host/otel_port/otel_interval_milliseconds/otel_ssl_active (a warning in every
# task log): the exporter now reads the standard OTEL_* variables (changed 2026-10-21). otel_on and otel_prefix are
# still Airflow options. Names stay airflow_* (prefix) and job="airflow" (OTEL_SERVICE_NAME below).
AIRFLOW__METRICS__OTEL_ON=True
AIRFLOW__METRICS__OTEL_PREFIX=airflow
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
OTEL_METRIC_EXPORT_INTERVAL=30000
# Airflow traces (dag_run / task_run / worker.<task> spans) over OTLP/HTTP -> Alloy :4318 -> Tempo (2026-10-21).
# OTEL_SERVICE_NAME is required for traces (without it they arrive as "unknown_service") and names the metrics' job.
# Task processes inherit these variables; pipelines/commons/tracing.py sets its own service.name and endpoint.
AIRFLOW__TRACES__OTEL_ON=True
OTEL_SERVICE_NAME=airflow
OTEL_TRACES_EXPORTER=otlp_proto_http
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
