    {
      "type": "barchart",
      "title": "Task failures and retries (30 days)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-airflow"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-airflow"
          },
          "rawSql": "SELECT task_id, count(*) FILTER (WHERE state = 'failed') AS failed, count(*) FILTER (WHERE try_number > 1) AS retried FROM task_instance_history WHERE dag_id = 'rfb_pipeline' AND start_date > now() - interval '30 days' GROUP BY task_id ORDER BY failed DESC, retried DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
