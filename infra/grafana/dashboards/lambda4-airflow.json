        "showValue": "auto",
        "barWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "groupWidth": 0.7,
        "stacking": "none",
        "xField": "task_id"
      },
