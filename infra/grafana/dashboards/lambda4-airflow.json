    {
      "type": "table",
      "title": "Task instances of the latest run",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-airflow"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-airflow"
          },
          "rawSql": "SELECT task_id, state, try_number, max_tries, pool, priority_weight, queued_dttm, start_date, end_date, round(duration::numeric) AS duration_s, round(extract(epoch FROM start_date - queued_dttm)::numeric, 1) AS queue_wait_s, hostname, pid FROM task_instance WHERE dag_id = 'rfb_pipeline' AND run_id = (SELECT run_id FROM dag_run WHERE dag_id = 'rfb_pipeline' ORDER BY coalesce(start_date, queued_at) DESC LIMIT 1) ORDER BY start_date NULLS LAST",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SUCCESS": {
                        "color": "green",
                        "index": 0
                      },
                      "FAILED": {
                        "color": "red",
                        "index": 1
                      },
                      "RUNNING": {
                        "color": "blue",
                        "index": 2
                      },
                      "SKIPPED": {
                        "color": "text",
                        "index": 3
                      },
                      "PASS": {
                        "color": "green",
                        "index": 4
                      },
                      "FAIL": {
                        "color": "red",
                        "index": 5
                      },
                      "OK": {
                        "color": "green",
                        "index": 6
