    {
      "type": "table",
      "title": "rfb_pipeline runs",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-airflow"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-airflow"
          },
          "rawSql": "SELECT run_id, state, run_type, conf->>'ref_month' AS ref_month, queued_at, start_date, end_date, round(extract(epoch FROM coalesce(end_date, now()) - start_date)) AS duration_s, triggering_user_name FROM dag_run WHERE dag_id = 'rfb_pipeline' ORDER BY coalesce(start_date, queued_at) DESC LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SUCCESS": {
                        "color": "green",
                        "index": 0
                      },
                      "FAILED": {
                        "color": "red",
                        "index": 1
                      },
                      "RUNNING": {
                        "color": "blue",
                        "index": 2
                      },
                      "SKIPPED": {
                        "color": "text",
                        "index": 3
                      },
                      "PASS": {
                        "color": "green",
                        "index": 4
                      },
                      "FAIL": {
                        "color": "red",
                        "index": 5
                      },
                      "OK": {
                        "color": "green",
                        "index": 6
                      },
                      "WARN": {
                        "color": "orange",
                        "index": 7
                      },
                      "BLOCK": {
                        "color": "red",
                        "index": 8
                      },
                      "success": {
                        "color": "green",
                        "index": 9
                      },
                      "failed": {
                        "color": "red",
                        "index": 10
                      },
                      "running": {
                        "color": "blue",
                        "index": 11
                      },
                      "queued": {
                        "color": "purple",
                        "index": 12
                      },
                      "skipped": {
                        "color": "text",
                        "index": 13
                      },
                      "upstream_failed": {
                        "color": "orange",
                        "index": 14
                      },
                      "up_for_retry": {
                        "color": "yellow",
                        "index": 15
                      },
                      "scheduled": {
                        "color": "purple",
                        "index": 16
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
